@@ -0,0 +1,88 @@
+#ifndef __AMDGPU_PLUGIN_SUBSET_H__
+#define __AMDGPU_PLUGIN_SUBSET_H__
+
+/*
+ * Restore onto a subset of the checkpointed GPUs.
+ *
+ * Built only into amdgpu_plugin_gem5.so (-DAMDGPU_PLUGIN_GEM5, the plugin
+ * for restoring MI300X checkpoints in a gem5 GPU full-system guest), where it
+ * is on by default (KFD_RESTORE_GPU_SUBSET=0 turns it off). The stock
+ * amdgpu_plugin.so is built without it: the stubs below compile the hooks
+ * away and it restores every checkpointed GPU, as upstream CRIU does.
+ *
+ * The ROCm runtime opens every visible GPU, so a process that only computes
+ * on one GPU of a multi-GPU node is checkpointed with a KFD process device
+ * (pdd) for every GPU. Stock restore needs an identical number of GPUs on the
+ * destination. With KFD_RESTORE_GPU_SUBSET=1, GPUs that hold no state other
+ * than their MMIO-remap page (no queues, no VRAM/GTT/userptr/doorbell BOs,
+ * never a preferred/prefetch/access location of an SVM range) are left out
+ * of the restore:
+ *  - their device entries and MMIO-remap BOs are not restored,
+ *  - they are removed from every BO's mapped_gpuids list and from the SVM
+ *    accessibility attributes in the KFD private data passed to the kernel,
+ *  - their render-node fds and MMIO-page CPU mappings are redirected to the
+ *    GPU that replaces a kept GPU of the same XGMI hive.
+ * The image files are not modified; everything is rewritten in memory.
+ *
+ * Rewriting the private data depends on the KFD's private CRIU layout
+ * (KFD_CRIU_PRIV_VERSION 1); the code refuses any other version or a blob
+ * that does not parse exactly.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "common/list.h"
+#include "criu-amdgpu.pb-c.h"
+#include "kfd_ioctl.h"
+#include "amdgpu_plugin_topology.h"
+
+#ifdef AMDGPU_PLUGIN_GEM5
+
+extern bool kfd_restore_gpu_subset;
+
+/*
+ * Select the GPUs to keep and filter e->device_entries / e->bo_entries and
+ * e->priv_data in place (the originals are kept for subset_undo()).
+ * Returns 0 when nothing was dropped or on success, negative errno on error.
+ */
+int subset_apply(CriuKfd *e);
+
+/* Count only restorable links in io_links_count of the source GPUs (after devinfo_to_topology()). */
+void subset_fix_src_topology(struct tp_system *src);
+
+/* Put back the original arrays so criu_kfd__free_unpacked() frees them. */
+void subset_undo(CriuKfd *e);
+
+/* True if gpu_id was a checkpointed GPU that subset_apply() dropped. */
+bool subset_is_dropped(uint32_t gpu_id);
+
+/* Kept source GPU that stands in for a dropped one (0 if none). */
+uint32_t subset_alias(uint32_t dropped_gpu_id);
+
+/* Dropped GPUs' MMIO-remap BOs, whose CPU mappings must be redirected. */
+uint32_t subset_num_dropped_mmio(void);
+const KfdBoEntry *subset_dropped_mmio(uint32_t i);
+
+/* Restored MMIO-remap BO of the kept GPU alias, used as the stand-in page. */
+struct kfd_criu_bo_bucket *subset_mmio_stand_in(struct kfd_criu_bo_bucket *bo_buckets, uint64_t num_bos,
+						uint32_t alias);
+
+#else /* !AMDGPU_PLUGIN_GEM5: stock plugin, restore all checkpointed GPUs */
+
+static inline int subset_apply(CriuKfd *e) { return 0; }
+static inline void subset_fix_src_topology(struct tp_system *src) {}
+static inline void subset_undo(CriuKfd *e) {}
+static inline bool subset_is_dropped(uint32_t gpu_id) { return false; }
+static inline uint32_t subset_alias(uint32_t dropped_gpu_id) { return 0; }
+static inline uint32_t subset_num_dropped_mmio(void) { return 0; }
+static inline const KfdBoEntry *subset_dropped_mmio(uint32_t i) { return NULL; }
+static inline struct kfd_criu_bo_bucket *subset_mmio_stand_in(struct kfd_criu_bo_bucket *bo_buckets,
+							      uint64_t num_bos, uint32_t alias)
+{
+	return NULL;
+}
+
+#endif /* AMDGPU_PLUGIN_GEM5 */
+
+#endif
