 plugins/amdgpu/Makefile                 |  23 +-
 plugins/amdgpu/amdgpu_plugin.c          |  96 ++++-
 plugins/amdgpu/amdgpu_plugin_subset.c   | 549 ++++++++++++++++++++++++
 plugins/amdgpu/amdgpu_plugin_subset.h   |  88 ++++
 plugins/amdgpu/amdgpu_plugin_topology.c |   8 +
 5 files changed, 756 insertions(+), 8 deletions(-)
