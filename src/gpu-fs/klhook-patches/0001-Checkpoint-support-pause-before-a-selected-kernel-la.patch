+// ---------------------------------------------------------------------------
+// Checkpointing: before a selected kernel launch, drain the GPU and hand the
+// process to a checkpointer (e.g. kl-ckpt.sh), then launch once released.
+//
+// Handshake (all paths from the environment):
+//   KL_CKPT_READY  the hook creates this file (containing its pid) when the
+//                  process is ready to be dumped
+//   KL_CKPT_GO     optional; the hook continues once this file exists
+//                  (checkpointer dumped with --leave-running)
+// The hook also continues once it finds itself restored: a restored process
+// is a new process, so its start time in /proc/self/stat changes.
+// ---------------------------------------------------------------------------
+
+// Base name of a kernel: "void ns::foo<float>(float*)" or its mangled form -> "foo".
+static std::string kernel_base_name(const char *name)
+{
+    int status = 0;
+    char *demangled = abi::__cxa_demangle(name, nullptr, nullptr, &status);
+    std::string s = (status == 0 && demangled) ? demangled : name;
+    free(demangled);
+
+    s = s.substr(0, s.find('('));                   // argument list
+    if (!s.empty() && s.back() == '>') {            // template arguments
+        int depth = 0;
+        size_t i = s.size();
+        while (i-- > 0) {
+            if (s[i] == '>') depth++;
+            else if (s[i] == '<' && --depth == 0) break;
+        }
+        s = s.substr(0, i);
+    }
+    size_t pos = s.rfind(' ');                      // return type
+    if (pos != std::string::npos) s = s.substr(pos + 1);
+    pos = s.rfind("::");                            // namespaces / classes
+    if (pos != std::string::npos) s = s.substr(pos + 2);
+    return s;
+}
+
+// Selection policy, the only place that decides which launch is checkpointed.
+// Current policy: KL_CKPT_KERNEL=<name>[:<n>] selects the n-th launch (default
+// 1st) of the kernel whose base name or mangled name is <name>.
+static bool kl_should_checkpoint(const char *kernel_name)
+{
+    static std::mutex lock;
+    static bool parsed = false;
+    static std::string want;
+    static long nth = 1, seen = 0;
+
+    std::lock_guard<std::mutex> guard(lock);
+    if (!parsed) {
+        parsed = true;
+        if (const char *env = std::getenv("KL_CKPT_KERNEL")) {
+            want = env;
+            size_t colon = want.rfind(':');
+            if (colon != std::string::npos && colon + 1 < want.size() &&
+                want.find_first_not_of("0123456789", colon + 1) == std::string::npos) {
+                nth = std::atol(want.c_str() + colon + 1);
+                want.resize(colon);
+            }
+        }
+    }
+    if (want.empty() || !kernel_name) return false;
+    if (want != kernel_name && want != kernel_base_name(kernel_name)) return false;
+    return ++seen == nth;
+}
+
+// Field 22 (starttime) of /proc/self/stat.
+static unsigned long long process_start_time()
+{
+    char buf[1024];
+    FILE *f = fopen("/proc/self/stat", "r");
+    if (!f) return 0;
+    size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+    fclose(f);
+    buf[n] = '\0';
+
+    char *p = strrchr(buf, ')');                    // comm may contain spaces
+    if (!p) return 0;
+    int field = 2;
+    char *save = nullptr;
+    for (char *tok = strtok_r(p + 1, " ", &save); tok; tok = strtok_r(nullptr, " ", &save)) {
+        if (++field == 22) return strtoull(tok, nullptr, 10);
+    }
+    return 0;
+}
+
+static void kl_checkpoint(const char *kernel_name)
+{
+    const char *ready = std::getenv("KL_CKPT_READY");
+    const char *go = std::getenv("KL_CKPT_GO");
+    if (!ready) {
+        std::cerr << "kl-hook: KL_CKPT_READY not set, not checkpointing before "
+                  << kernel_name << std::endl;
+        return;
+    }
+
+    hipError_t err = hipDeviceSynchronize_func();
+    if (err != hipSuccess) {
+        std::cerr << "kl-hook: hipDeviceSynchronize failed (" << err << "), not checkpointing\n";
+        return;
+    }
+    std::cout << "kl-hook: checkpoint before kernel " << kernel_base_name(kernel_name) << std::endl;
+    fflush(nullptr);
+
+    unsigned long long start = process_start_time();
+    FILE *f = fopen(ready, "w");
+    if (!f) {
+        perror("kl-hook: KL_CKPT_READY");
+        return;
+    }
+    fprintf(f, "%d\n", getpid());
+    fclose(f);
+
+    for (;;) {
+        usleep(50000);
+        if (process_start_time() != start) {
+            std::cout << "kl-hook: restored" << std::endl;
+            break;
+        }
+        if (go && access(go, F_OK) == 0) break;
+    }
+}
+
+static bool ckpt_enabled()
+{
+    static const bool enabled = std::getenv("KL_CKPT_KERNEL") != nullptr;
+    return enabled;
+}
+
+// Called by every launch wrapper (when verbose or checkpointing is on).
+static void kl_on_launch(const char *kernel_name)
+{
+    if (verbose) {
+        std::cout << "kl-hook: kernel " << (kernel_name ? kernel_base_name(kernel_name) : "?") << "\n";
+    }
+    if (ckpt_enabled() && kl_should_checkpoint(kernel_name)) kl_checkpoint(kernel_name);
+}
