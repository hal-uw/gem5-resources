-// Called by every launch wrapper (when verbose or checkpointing is on).
+// KL_HOOK_COUNTS=<file>: count launches per kernel base name and write
+// "<count>\t<name>" lines, most launched first, to <file> at exit.
+static const char *counts_path()
+{
+    static const char *path = std::getenv("KL_HOOK_COUNTS");
+    return path;
+}
+
+static std::mutex counts_lock;
+// Heap-allocated so they outlive static destructors that run before atexit handlers.
+static auto *counts = new std::unordered_map<std::string, long>;
+static auto *base_names = new std::unordered_map<const char *, std::string>;
+
+static void write_counts()
+{
+    std::lock_guard<std::mutex> guard(counts_lock);
+    std::vector<std::pair<std::string, long>> v(counts->begin(), counts->end());
+    std::sort(v.begin(), v.end(), [](const auto &a, const auto &b) {
+        return a.second != b.second ? a.second > b.second : a.first < b.first;
+    });
+    FILE *f = fopen(counts_path(), "w");
+    if (!f) {
+        perror("kl-hook: KL_HOOK_COUNTS");
+        return;
+    }
+    for (const auto &[name, n] : v) fprintf(f, "%ld\t%s\n", n, name.c_str());
+    fclose(f);
+}
+
+static void count_launch(const char *kernel_name)
+{
+    std::lock_guard<std::mutex> guard(counts_lock);
+    static bool registered = false;
+    if (!registered) {  // after HIP's own atexit handlers, so this runs before them
+        registered = true;
+        atexit(write_counts);
+    }
+    auto it = base_names->find(kernel_name);  // names are stable pointers: demangle once
+    if (it == base_names->end())
+        it = base_names->emplace(kernel_name, kernel_name ? kernel_base_name(kernel_name) : "?").first;
+    ++(*counts)[it->second];
+}
+
+static bool hooked()
+{
+    return verbose || ckpt_enabled() || counts_path();
+}
+
+// Called by every launch wrapper (when verbose, checkpointing or counting is on).
 static void kl_on_launch(const char *kernel_name)
 {
     if (verbose) {
         std::cout << "kl-hook: kernel " << (kernel_name ? kernel_base_name(kernel_name) : "?") << "\n";
     }
+    if (counts_path()) count_launch(kernel_name);
     if (ckpt_enabled() && kl_should_checkpoint(kernel_name)) kl_checkpoint(kernel_name);
 }
 
