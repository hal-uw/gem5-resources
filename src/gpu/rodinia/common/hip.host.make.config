# HIP (ROCm) build for AMD GPUs: link as common/host.make.config.
# Every app includes common/kernel_timer.h and reports per-kernel runtimes;
# the my_timing.h wall-clock CSV is disabled. C files go to gcc, C++ files
# (some include the HIP runtime) to hipcc.
HIP_PATH ?= /opt/rocm
OFFLOAD_ARCH ?= gfx900,gfx90a,gfx942

CC = gcc
CXX = $(HIP_PATH)/bin/hipcc
NVCC = $(HIP_PATH)/bin/hipcc
LINKER = $(HIP_PATH)/bin/hipcc

NVCC_FLAGS = -O3 --offload-arch=$(OFFLOAD_ARCH) -D_MY_IS_HIP -DMY_TIMING_DISABLE -Wno-unused-result
LINKER_FLAGS = -O3 --offload-arch=$(OFFLOAD_ARCH) -lm
CC_FLAGS = -O3 -DMY_TIMING_DISABLE
CXX_FLAGS = -O3 --offload-arch=$(OFFLOAD_ARCH) -DMY_TIMING_DISABLE

# no COMPILER_NAME: it only labels the my_timing.h CSV, and defining it
# (_MY_COMPILER_NAME_) switches streamcluster to the fork's modified input

# nvcc-only flags some Makefiles pass
PTXAS_VERBOSE =
